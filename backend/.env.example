[TEMPLATE]
PORT=5000
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# Set to 1 when hosted behind a proxy / load balancer (Render, Fly.io, Nginx, etc.)
TRUST_PROXY=1
# Leave unset to use the local JSON file. Set to your MongoDB Atlas connection
# string to store users/resumes in the cloud (survives redeploys).
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/
